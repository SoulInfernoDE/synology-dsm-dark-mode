#!/bin/sh
# Rebuild the dark stylesheet from the stylesheets DSM currently loads.
#
# The list of stylesheets (in load order) comes from DSM's own start page. When
# the package cannot fetch it (other ports, HTTPS only, access rules), the list
# a browser reported at login is used instead (var/page-sheets.txt), and as a
# last resort the start page saved by an earlier run. Stylesheets a browser
# loaded later are added from var/extra-sheets.txt. Both files are written by
# regen.cgi. Runs as the package user.

SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
TARGET="${SYNOPKG_PKGDEST:-$(dirname "$(dirname "$SELF")")}"
# The package name differs between the GitHub and the SynoCommunity package.
PKG="${SYNOPKG_PKGNAME:-$(basename "$(readlink -f "$TARGET")")}"
VAR="${SYNOPKG_PKGVAR:-/var/packages/${PKG}/var}"
UI="$TARGET/ui"
LOCK="$VAR/regen.lock"
LOG="$VAR/regen.log"

mkdir -p "$VAR"

# --off: the package is stopped. DSM keeps linking ui/style.css even then, so
# end a running build and leave only the always active rules and an empty dark
# block (the next start rebuilds the theme). The precompressed copy has to go
# as well: DSM's web server prefers it.
if [ "${1:-}" = "--off" ]; then
  pid="$(cat "$LOCK/pid" 2>/dev/null)"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    # Started with setsid: the build and its generator form one process group.
    kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null
    # Wait until it is gone, so it cannot write the stylesheet afterwards.
    i=0
    while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 20 ]; do
      sleep 0.5
      i=$((i + 1))
    done
    rm -rf "$LOCK"
  fi
  {
    echo "/* DSM Dark Mode - package stopped, theme off. */"
    cat "$TARGET/share/base.css"
    echo "@media (prefers-color-scheme: dark){}"
  } > "$UI/style.css.tmp" && mv "$UI/style.css.tmp" "$UI/style.css"
  rm -f "$UI/style.css.gz"
  printf '{"state":"off","time":%s}\n' "$(date +%s)" > "$UI/status.json"
  exit 0
fi

# One run at a time. The lock holds the PID of the running build; a lock
# whose process is gone (killed during a package upgrade) is taken over.
take_lock() {
  mkdir "$LOCK" 2>/dev/null || return 1
  echo $$ > "$LOCK/pid"
}
if ! take_lock; then
  pid="$(cat "$LOCK/pid" 2>/dev/null)"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    exit 0
  fi
  rm -rf "$LOCK"
  take_lock || exit 0
fi
trap 'rm -rf "$LOCK"' EXIT
# A trap on INT/TERM replaces the default, so end explicitly (package stop).
trap 'exit 1' INT TERM

# Build state for the desktop script (ui/status.json, readable by every
# signed-in user): "running", "ok" or "failed". Details stay in the log.
status() {
  printf '{"state":"%s","time":%s}\n' "$1" "$(date +%s)" > "$UI/status.json.tmp" \
    && mv "$UI/status.json.tmp" "$UI/status.json"
}

log() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$LOG"
}

# Keep the log short.
if [ -f "$LOG" ] && [ "$(wc -l < "$LOG")" -gt 500 ]; then
  tail -n 200 "$LOG" > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"
fi

conf_port() {
  sed -n "s/^$1=\"\{0,1\}\([0-9]*\)\"\{0,1\}\$/\1/p" /etc/synoinfo.conf 2>/dev/null | head -n1
}
http_port="$(conf_port admin_port)"
https_port="$(conf_port secure_admin_port)"

# Saves DSM's start page to var/index.html. Redirects are not followed (they
# may point to an external domain); HTTPS is tried as well. On failure
# $fetch_error says what happened for each address.
fetch_start_page() {
  fetch_error=""
  for url in "http://127.0.0.1:${http_port:-5000}/" "https://127.0.0.1:${https_port:-5001}/"; do
    code="$(curl -sSk --max-time 20 -o "$VAR/index.html.tmp" -w '%{http_code}' "$url" 2>"$VAR/curl.err")"
    if [ "$code" = "200" ] && grep -q 'rel="stylesheet"' "$VAR/index.html.tmp" 2>/dev/null; then
      mv "$VAR/index.html.tmp" "$VAR/index.html"
      rm -f "$VAR/curl.err"
      return 0
    fi
    fetch_error="$fetch_error [$url HTTP ${code:-000}$(head -c 160 "$VAR/curl.err" 2>/dev/null | tr '\n' ' ' | sed 's/^/ /')]"
  done
  rm -f "$VAR/index.html.tmp" "$VAR/curl.err"
  return 1
}

status running

# At boot the web server may not be up yet: retry for a few minutes, unless a
# list reported by a browser is available.
tries="${1:-1}"
i=0
source=""
while :; do
  if fetch_start_page; then
    source=index
    break
  fi
  if [ -s "$VAR/page-sheets.txt" ]; then
    log "start page not reachable:$fetch_error - using the stylesheet list reported by the browser"
    source=browser
    break
  fi
  i=$((i + 1))
  if [ "$i" -ge "$tries" ]; then
    if [ -f "$VAR/index.html" ]; then
      log "start page not reachable:$fetch_error - using the start page saved earlier"
      source=index
      break
    fi
    log "start page not reachable:$fetch_error - waiting for the next login, the browser then reports the stylesheet list"
    status waiting
    exit 1
  fi
  sleep 10
done

if [ "$source" = "index" ]; then
  set -- --index "$VAR/index.html"
else
  set -- --list "$VAR/page-sheets.txt"
fi

if python3 "$TARGET/lib/darkgen.py" "$@" \
     --root /usr/syno/synoman \
     --own-dir "webman/3rdparty/${PKG}/" \
     --list "$VAR/extra-sheets.txt" \
     --base "$TARGET/share/base.css" \
     --extra "$TARGET/share/extra.css" \
     --cache "$VAR/img-cache" \
     --manifest "$UI/manifest.json" \
     --out "$UI/style.css" 2>> "$LOG"; then
  log "stylesheet rebuilt"
  status ok
else
  log "generator failed"
  status failed
  exit 1
fi
